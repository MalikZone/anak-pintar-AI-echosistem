# =============================================================================
# Root .gitignore for Anak Pintar AI Ecosystem (Hadirin & AI Shared Orchestration)
# =============================================================================

# --- 1. Environment & Secrets (MANDATORY TO IGNORE) ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# --- 2. Node & Frontend Artifacts ---
node_modules/
dist/
dist-ssr/
build/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.vite/

# --- 3. Python Virtual Environments & Caches ---
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
develop-eggs/
eggs/
parts/
bin/
var/
sdist/
downloads/

# --- 4. Database, Local Vector Store & Storage Caches ---
qdrant_storage/
*.sqlite
*.sqlite3
*.db
tmp/
temp/
logs/
*.log

# --- 5. Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- 6. Editor & IDE Settings ---
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

