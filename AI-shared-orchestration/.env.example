# =============================================================================
# AI-SHARED-ORCHESTRATION ENVIRONMENT CONFIGURATION
# Shared Core for Hadirin (Workforce & HR) and LISA (Gold Market Intelligence)
# =============================================================================

# --- 1. Gatekeeper FastAPI Service ---
APP_NAME=AI-Shared-Orchestration-Gatekeeper
APP_ENV=development
GATEKEEPER_HOST=0.0.0.0
GATEKEEPER_PORT=8000
DEFAULT_INTENT_THRESHOLD=0.78

# --- 2. Qdrant Vector Database ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_HADIRIN_INTENTS=hadirin_intents
QDRANT_COLLECTION_HADIRIN_DOCS=hadirin_documents
QDRANT_COLLECTION_LISA_INTENTS=lisa_intents

# --- 3. Local Embedding Model (FastEmbed ONNX CPU) ---
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# --- 4. Temporal Orchestration Engine ---
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_HADIRIN_TASK_QUEUE=HADIRIN_HR_QUEUE
TEMPORAL_LISA_TASK_QUEUE=LISA_MARKET_QUEUE
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=temporal
TEMPORAL_DB_NAME=temporal

# --- 5. LLM Provider Adapter (Dependency Inversion Switch) ---
# Options: mock | ollama
# Use 'mock' on Mac during Pre-LLM Phase; switch to 'ollama' when Home PC is ready.
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# --- 6. Hadirin MySQL System of Record ---
HADIRIN_DB_HOST=127.0.0.1
HADIRIN_DB_PORT=3306
HADIRIN_DB_USER=root
HADIRIN_DB_PASSWORD=
HADIRIN_DB_NAME=hadirin
HADIRIN_BACKEND_URL=http://localhost:5001/api/v1

